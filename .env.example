# Copy to .env and fill in. `pg` reads the PG* variables directly.
PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=breadlog

# Optional locally; required in the cloud. Turns on the sign-in screen.
# Wrap it in double quotes if it contains # (otherwise the rest is read as a comment).
# APP_PASSWORD="a-long-passphrase-you-will-remember"
